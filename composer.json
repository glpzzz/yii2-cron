{
    "name": "glpzzz/yii2-cron",
    "description": "Attribute-driven cron discovery and crontab sync for Yii2 console apps",
    "type": "library",
    "keywords": ["yii2", "cron", "crontab", "console", "scheduler", "attributes"],
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriel A. López López",
            "email": "glpz@daxslab.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.14"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5",
        "yiisoft/yii2-coding-standards": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "glpzzz\\cron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "glpzzz\\cron\\tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
